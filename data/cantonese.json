    {"id": "yue-dozi", "kind": "phrase", "set": "Start here", "zh": "多謝", "jyutping": "do1-ze6", "en": "Thank you (for a gift)", "topic": "Small talk", "mission": "Thank someone for a gift or compliment with 多謝", "situation": "A colleague gives you a small gift."},
    {"id": "yue-hai", "kind": "word", "set": "Start here", "zh": "係", "jyutping": "hai6", "en": "yes; to be", "note": "Cantonese 係 = Mandarin 是"},
