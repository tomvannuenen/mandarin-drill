{
  "items": [
    {"id": "yue-nei-hou", "kind": "phrase", "set": "Start here", "zh": "你好", "jyutping": "nei5 hou2", "en": "Hello", "topic": "Small talk", "mission": "Greet the security guard or a shopkeeper with 你好", "situation": "You greet the security guard."},
