    {"id": "ni-ji-nianji", "kind": "phrase", "set": "Meeting people at CUHK", "zh": "你幾年級？", "pinyin": "nǐ jǐ nián-jí?", "en": "What year are you in?", "topic": "Meeting people", "mission": "Ask a student what year they're in"},
