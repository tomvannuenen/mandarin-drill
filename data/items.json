    {"id": "ni-xihuan-he-shenme", "kind": "phrase", "week": 1, "zh": "你喜歡喝什麼？", "pinyin": "nǐ xǐ-huān hē shé-me?", "en": "What do you like to drink?", "topic": "Food & drink", "mission": "Ask someone what they like to drink"},
