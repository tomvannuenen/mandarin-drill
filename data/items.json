    {"id": "la", "kind": "word", "week": 1, "zh": "辣", "pinyin": "là", "en": "spicy", "fillEn": "spicy food", "cat": ["food"]},
    {"id": "mapo-doufu", "kind": "word", "week": 1, "zh": "麻婆豆腐", "pinyin": "má-pó-dòu-fǔ", "en": "mapo tofu", "cat": ["food"]},
    {"id": "wo-xihuan-chi-x", "kind": "pattern", "week": 1, "zh": "我喜歡吃{food}", "pinyin": "wǒ xǐ-huān chī {food}", "en": "I like eating {food}", "topic": "Food & drink", "mission": "Tell someone at lunch what you like to eat"},
    {"id": "yao-bu-yao-la", "kind": "phrase", "week": 1, "zh": "要不要辣？", "pinyin": "yào bù yào là?", "en": "Do you want it spicy?", "topic": "Food & drink"},
