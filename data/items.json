    {"id": "ni-shi-xuesheng-ma", "kind": "phrase", "set": "Meeting people at CUHK", "zh": "你是學生嗎？", "pinyin": "nǐ shì xué-shēng ma?", "en": "Are you a student?", "topic": "Meeting people", "mission": "Ask someone on campus if they're a student"},
