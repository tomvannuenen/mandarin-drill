{
  "items": [
    {"id": "dajia-hao", "kind": "phrase", "week": 1, "zh": "大家好", "pinyin": "dà-jiā hǎo", "en": "Hello everyone", "topic": "Introducing yourself", "mission": "Open a class or meeting with 大家好"},
    {"id": "wo-jiao", "kind": "phrase", "week": 1, "zh": "我叫……", "pinyin": "wǒ jiào …", "en": "My name is…", "note": "我是…… (wǒ shì…) = I am…", "topic": "Introducing yourself", "mission": "Tell someone your name in Mandarin"},
    {"id": "xiexie", "kind": "phrase", "week": 1, "zh": "謝謝", "pinyin": "xiè-xie", "en": "Thank you", "topic": "Small talk", "mission": "Thank a shop assistant or a colleague with 謝謝"},
    {"id": "hen-gaoxing-renshi-ni", "kind": "phrase", "week": 1, "zh": "很高興認識你", "pinyin": "hěn gāo-xìng rèn-shì nǐ", "en": "Nice to meet you", "topic": "Introducing yourself", "mission": "Say it to someone you meet for the first time"},
    {"id": "hen-gaoxing-renshi-dajia", "kind": "phrase", "week": 1, "zh": "很高興認識大家", "pinyin": "hěn gāo-xìng rèn-shì dà-jiā", "en": "Nice to meet you all", "topic": "Introducing yourself", "mission": "Use it when you're introduced to a group"},
    {"id": "helan", "kind": "word", "week": 1, "zh": "荷蘭", "pinyin": "Hé-lán", "en": "the Netherlands", "demonym": "Dutch", "cat": ["country"]},
    {"id": "wo-laizi-x", "kind": "pattern", "week": 1, "zh": "我來自{country}", "pinyin": "wǒ lái-zì {country}", "en": "I come from {country}", "topic": "Introducing yourself", "mission": "Tell a colleague or taxi driver where you're from", "mine": "helan"},
    {"id": "wo-shi-x-ren", "kind": "pattern", "week": 1, "zh": "我是{country}人", "pinyin": "wǒ shì {country} rén", "en": "I am {country:demonym}", "note": "Country + 人 (rén, person) = nationality", "topic": "Introducing yourself", "mission": "When someone asks where you're from, answer in Mandarin", "mine": "helan"},
    {"id": "wo-shi-laoshi", "kind": "phrase", "week": 1, "zh": "我是老師", "pinyin": "wǒ shì lǎo-shī", "en": "I am a teacher", "topic": "Work & study"},
    {"id": "wo-shi-jiaoshou", "kind": "phrase", "week": 1, "zh": "我是教授", "pinyin": "wǒ shì jiào-shòu", "en": "I am a professor", "note": "我是 [subject] 教授 = I'm a professor of [subject]", "topic": "Work & study", "mission": "Tell someone off campus what you do"},
    {"id": "wo-lai-zhongda-shouke", "kind": "phrase", "week": 1, "zh": "我來香港中文大學授課", "pinyin": "wǒ lái Xiāng-gǎng Zhōng-wén Dà-xué shòu-kè", "en": "I come to CUHK to teach", "topic": "Work & study", "mission": "Explain why you're in Hong Kong"},
    {"id": "wo-zai-zhongda-jiaoshu", "kind": "phrase", "week": 1, "zh": "我在中文大學教書", "pinyin": "wǒ zài Zhōng-wén Dà-xué jiāo-shū", "en": "I teach at the Chinese University", "note": "教 (jiāo) + course/subject = teach …; note jiāo here vs jiào in 教授", "topic": "Work & study", "mission": "Tell a Mandarin-speaking colleague where you teach"},
    {"id": "zuijin-hao-ma", "kind": "phrase", "week": 1, "zh": "最近好嗎？", "pinyin": "zuì-jìn hǎo ma?", "en": "How have you been lately?", "topic": "Small talk", "mission": "Greet a Mandarin-speaking colleague with it"},
    {"id": "zuijin-zenmeyang", "kind": "phrase", "week": 1, "zh": "最近怎麼樣？", "pinyin": "zuì-jìn zěn-me-yàng?", "en": "How are things recently?", "topic": "Small talk", "mission": "Ask a colleague how things are"},
    {"id": "zuijin-mang-shenme", "kind": "phrase", "week": 1, "zh": "最近忙什麼？", "pinyin": "zuì-jìn máng shé-me?", "en": "What have you been busy with lately?", "topic": "Small talk", "mission": "Ask your coach what they've been busy with"},
